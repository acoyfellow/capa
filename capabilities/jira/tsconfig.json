{
	"compilerOptions": {
		"target": "es2022",
		"module": "es2022",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["@cloudflare/workers-types/2023-07-01"],
		"lib": ["es2022"]
	},
	"include": ["src/**/*.ts"]
}
