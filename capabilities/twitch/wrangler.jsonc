{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "capa-twitch",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-17",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": { "enabled": true }
	// Required secrets:
	//   wrangler secret put TWITCH_API_KEY     # OAuth token
	//   wrangler secret put TWITCH_CLIENT_ID   # Twitch app client id
	// Service binding entrypoint: TwitchCapability
}
