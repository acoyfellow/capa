{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "capa-stripe",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-25",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": { "enabled": true },
	"vars": {
		"CAPA_VERSION": "v0",
		"CAPA_NAME": "stripe"
	}
	// Required secrets (set after deploy):
	//   wrangler secret put STRIPE_SECRET_KEY
	//
	// This Worker exposes JSRPC entrypoints. Bind from a caller Worker:
	//   "services": [
	//     { "binding": "STRIPE_PROOF", "service": "capa-stripe", "entrypoint": "StripeCapability" }
	//   ]
	// Then: const { result, evidence } = await env.STRIPE_PROOF.charge({ amount, currency, source });
}
