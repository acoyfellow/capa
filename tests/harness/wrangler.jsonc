{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "capa-test-harness",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-17",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": { "enabled": true },
	"services": [
		{
			"binding": "TARGET",
			"service": "capa-gitlab",
			"entrypoint": "GitlabCapability"
		}
	]
}
