---
/**
 * Starlight head override with first-class 1200x630 capa social cards.
 * Mirrors the latest unsurf docs pattern: retain Starlight's generated head,
 * then add deterministic per-page PNG OG/Twitter tags and JSON-LD.
 */
const route = Astro.locals.starlightRoute;
const { head } = route;

const siteUrl = 'https://capa.coey.dev';
const slug = route.id || 'index';
const path = slug === 'index' ? '/' : `/${slug}/`;
const canonicalUrl = `${siteUrl}${path}`;
const ogImageUrl = `${siteUrl}/og/${slug}.png`;
const title = route.entry.data.title;
const description = route.entry.data.description || 'Ready-to-bind Cloudflare Workers for third-party APIs.';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	description,
	url: canonicalUrl,
	image: ogImageUrl,
	isPartOf: {
		'@type': 'WebSite',
		name: 'capa',
		url: siteUrl,
	},
	publisher: {
		'@type': 'Organization',
		name: 'capa',
		url: siteUrl,
		logo: {
			'@type': 'ImageObject',
			url: `${siteUrl}/og/index.png`,
		},
	},
};
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<link rel="preload" href="/fonts/kunst-grotesk-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href="/fonts/kunst-grotesk-medium.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:site" content="@acoyfellow" />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
