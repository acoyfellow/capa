---
import { getCapabilities, getPlanned, getCatalogStats, formatNumber } from '../data/capabilities';

interface Props {
	stats?: boolean;
	planned?: boolean;
}

const { stats = false, planned = false } = Astro.props;
const caps = getCapabilities();
const plannedEntries = planned ? getPlanned() : [];
const totals = stats ? getCatalogStats() : null;
---

{totals && (
	<dl class="capa-stats not-content" aria-label="Catalog totals">
		<div class="capa-stat">
			<dt class="capa-stat__label">Capabilities</dt>
			<dd class="capa-stat__value">{formatNumber(totals.capabilityCount)}</dd>
		</div>
		<div class="capa-stat">
			<dt class="capa-stat__label">Operations</dt>
			<dd class="capa-stat__value">{formatNumber(totals.totalOperations)}</dd>
		</div>
		<div class="capa-stat">
			<dt class="capa-stat__label">Namespaces</dt>
			<dd class="capa-stat__value">{formatNumber(totals.totalNamespaces)}</dd>
		</div>
	</dl>
)}

{caps.length === 0 ? (
	<p class="capa-note">
		No capabilities found. Add a <code>capa.manifest.json</code> to <code>capabilities/&lt;name&gt;/</code>.
	</p>
) : (
	<ul class="capa-catalog not-content" aria-label="Generated capa capabilities">
		{caps.map((entry) => (
			<li class="capa-catalog__row">
				<div class="capa-catalog__main">
					<a class="capa-catalog__name" href={entry.repoUrl} rel="noreferrer noopener">{entry.name}</a>
					{entry.tagline && <p class="capa-catalog__tagline">{entry.tagline}</p>}
				</div>
				<dl class="capa-catalog__meta">
					<div><dt>Operations</dt><dd class="capa-numeric">{formatNumber(entry.operations)}</dd></div>
					<div><dt>Auth</dt><dd>{entry.authLabel}</dd></div>
					<div><dt>Entrypoint</dt><dd><code>{entry.entrypoint}</code></dd></div>
				</dl>
				<div class="capa-catalog__actions">
					<a class="capa-button" href={entry.deployUrl} rel="noreferrer noopener">Deploy</a>
					<a class="capa-button" href={entry.source.spec} rel="noreferrer noopener">Spec</a>
				</div>
			</li>
		))}
	</ul>
)}

{plannedEntries.length > 0 && (
	<section aria-label="Planned capabilities">
		<h3>Planned</h3>
		<ul>
			{plannedEntries.map((p) => <li><strong>{p.name}</strong>: {p.tagline}</li>)}
		</ul>
	</section>
)}
