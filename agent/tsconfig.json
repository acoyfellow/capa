{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": [
			"@cloudflare/workers-types"
		],
		"allowImportingTsExtensions": true
	},
	"include": [
		"src",
		"cloudflare.config.ts"
	]
}